name: PIPELINE-FINAL-DESPACHOS-AQUI

on:
  push:
    branches: [ "deploy" ]

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout
      uses: actions/checkout@v3

    - name: AWS Credentials
      uses: aws-actions/configure-aws-credentials@v1
      with:
        aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
        aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
        aws-region: us-east-1

    - name: Push to Despachos
      run: |
        # LOGIN
        aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 536869461511.dkr.ecr.us-east-1.amazonaws.com
        
        # ENTRAR A DESPACHOS
        cd back-Despachos_SpringBoot || cd */back-Despachos_SpringBoot
        cp "$GITHUB_WORKSPACE/Dockerfile" .
        
        # EL COMANDO CLAVE (MIRA QUE DIGA DESPACHOS)
        docker build -t 536869461511.dkr.ecr.us-east-1.amazonaws.com/innovatech-despachos:latest .
        docker push 536869461511.dkr.ecr.us-east-1.amazonaws.com/innovatech-despachos:latest
