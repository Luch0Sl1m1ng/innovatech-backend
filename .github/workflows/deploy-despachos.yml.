name: Deploy Despachos to Amazon ECR

on:
  push:
    branches: [ "deploy" ]

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v3

    - name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v1
      with:
        aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
        aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
        aws-region: us-east-1

    - name: Login to Amazon ECR
      id: login-ecr
      uses: aws-actions/amazon-ecr-login@v1

    - name: Build, tag, and push image to Amazon ECR
      env:
        ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        # NOMBRE DE TU REPO EN AWS
        ECR_REPOSITORY: innovatech-despachos
        IMAGE_TAG: latest
      run: |
        # Nombre de la carpeta que me pasaste antes
        TARGET_DIR=$(find . -type d -name "back-Despachos_SpringBoot" | head -n 1)
        
        if [ -z "$TARGET_DIR" ]; then
          echo "ERROR: No se encontró la carpeta back-Despachos_SpringBoot"
          exit 1
        fi
        
        cd "$TARGET_DIR"
        cp "$GITHUB_WORKSPACE/Dockerfile" .
        
        docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG .
        docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG

    - name: Deploy to EC2 via SSH
      uses: appleboy/ssh-action@master
      with:
        host: ${{ secrets.EC2_HOST }}
        username: ec2-user
        key: ${{ secrets.SSH_PRIVATE_KEY }}
        script: |
          aws configure set aws_access_key_id ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws configure set aws_secret_access_key ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws configure set aws_session_token ${{ secrets.AWS_SESSION_TOKEN }}
          
          aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${{ steps.login-ecr.outputs.registry }}
          
          docker pull ${{ steps.login-ecr.outputs.registry }}/innovatech-depachos:latest
          
          docker stop back-despachos || true
          docker rm back-despachos || true
          
          # PUERTO 8082 para Despachos
          docker run -d --name back-despachos -p 8082:8081 ${{ steps.login-ecr.outputs.registry }}/innovatech-depachos:latest
