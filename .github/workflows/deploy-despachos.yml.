name: Deploy Despachos to Amazon ECR

on:
  push:
    branches: [ "deploy" ]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v3

    - name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v1
      with:
        aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
        aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
        aws-region: us-east-1

    - name: Build and Push (Direct Mode)
      run: |
        # 1. Login Manual
        aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 536869461511.dkr.ecr.us-east-1.amazonaws.com
        
        # 2. Entrar a la carpeta y preparar
        TARGET_DIR=$(find . -type d -name "back-Despachos_SpringBoot" | head -n 1)
        cd "$TARGET_DIR"
        cp "$GITHUB_WORKSPACE/Dockerfile" .
        
        # 3. Build con TAG explícito
        docker build -t 536869461511.dkr.ecr.us-east-1.amazonaws.com/innovatech-despachos:latest .
        
        # 4. Push directo
        docker push 536869461511.dkr.ecr.us-east-1.amazonaws.com/innovatech-despachos:latest

    - name: SSH Deploy
      uses: appleboy/ssh-action@master
      with:
        host: ${{ secrets.EC2_HOST }}
        username: ec2-user
        key: ${{ secrets.SSH_PRIVATE_KEY }}
        script: |
          aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 536869461511.dkr.ecr.us-east-1.amazonaws.com
          docker pull 536869461511.dkr.ecr.us-east-1.amazonaws.com/innovatech-despachos:latest
          docker stop back-despachos || true
          docker rm back-despachos || true
          docker run -d --name back-despachos -p 8082:8081 536869461511.dkr.ecr.us-east-1.amazonaws.com/innovatech-despachos:latest
